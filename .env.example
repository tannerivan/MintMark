# MintMark™ — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is in .gitignore.

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Neon PostgreSQL)
# Neon provides two connection strings: pooled (for app queries) and direct
# (for migrations). Both are required.
# Get them at: https://console.neon.tech → your project → Connection Details
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# CLERK (Authentication)
# Get these at: https://dashboard.clerk.com → your app → API Keys
# CLERK_WEBHOOK_SECRET: create a webhook in Clerk pointing to
#   https://yourdomain.com/api/webhooks/clerk
#   and copy the signing secret here.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_WEBHOOK_SECRET=whsec_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC (AI Analysis)
# Get your key at: https://console.anthropic.com → API Keys
# NEVER expose this key on the client. All AI calls are server-side only.
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE (Subscriptions — $4.99/month Pro)
# Get keys at: https://dashboard.stripe.com → Developers → API Keys
# STRIPE_WEBHOOK_SECRET: run `stripe listen` locally or set webhook in Stripe
#   dashboard pointing to https://yourdomain.com/api/webhooks/stripe
# STRIPE_PRO_PRICE_ID: the Price ID for the $4.99/month product
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRO_PRICE_ID=price_xxxx

# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH REDIS (Rate Limiting — 5 free lookups/day)
# Create a free Redis database at: https://console.upstash.com
# Copy the REST URL and token from the database dashboard.
# ─────────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ─────────────────────────────────────────────────────────────────────────────
# AFFILIATE LINKS (Placeholder — drop in real IDs when accounts are approved)
# These are appended to PCGS/NGC grading recommendation links.
# ─────────────────────────────────────────────────────────────────────────────
PCGS_AFFILIATE_ID=PLACEHOLDER
NGC_AFFILIATE_ID=PLACEHOLDER

# ─────────────────────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
